# DropLinq (Expo public vars — never put the Supabase service role key here)

EXPO_PUBLIC_DATA_MODE=mock
# EXPO_PUBLIC_DATA_MODE=supabase

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: test subscription gating in development (FREE | PRO | PRO_PLUS)
# EXPO_PUBLIC_DEV_SUBSCRIPTION_TIER=PRO

# Existing monitor / Expo project (push tokens, optional Railway monitor)
EXPO_PUBLIC_MONITOR_API_URL=https://your-droplinq-monitor.up.railway.app
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

EXPO_NO_REDIRECT_PAGE=1

# OAuth (Apple / Google) setup in Supabase Dashboard → Authentication → Providers:
# 1. Enable Google and Apple
# 2. Authentication → URL Configuration → Redirect URLs, add:
#    droplinq://auth/callback
#    exp://127.0.0.1:8081/--/auth/callback
#    (and your LAN exp://… URL from Expo Go if needed)
# Apple native Sign in on device also needs the Apple provider configured with your Services ID / key.

# Web (static host — Cloudflare Pages / Render / Netlify)
# After you deploy, add these to Supabase → Authentication → Redirect URLs:
#    https://YOUR-SITE.pages.dev/auth/callback
#    https://YOUR-CUSTOM-DOMAIN/auth/callback
#    http://localhost:8081/auth/callback

